{
  "name": "tamperguard",
  "version": "0.3.0",
  "description": "Zero-dependency client-side DOM integrity monitor: notice and report unexpected changes to selected page regions, with an opt-in page lock.",
  "main": "./dist/tamperguard.umd.js",
  "module": "./dist/tamperguard.mjs",
  "browser": "./dist/tamperguard.umd.js",
  "unpkg": "./dist/tamperguard.min.js",
  "jsdelivr": "./dist/tamperguard.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./dist/tamperguard.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/tamperguard.umd.js"
      },
      "default": "./dist/tamperguard.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run build && playwright test",
    "test:chromium": "npm run build && playwright test --project=chromium",
    "test:package": "node --test test/package.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "check": "npm run build && npm run test:package && npm run test:types && playwright test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "pack:check": "npm run build && node scripts/check-package.mjs"
  },
  "keywords": [
    "tamper",
    "tamper-detection",
    "integrity",
    "dom",
    "mutationobserver",
    "security",
    "anti-tamper",
    "client-side"
  ],
  "author": "Ammar Saleh",
  "license": "MIT",
  "homepage": "https://github.com/ammar-saleh/tamperguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ammar-saleh/tamperguard.git"
  },
  "bugs": {
    "url": "https://github.com/ammar-saleh/tamperguard/issues"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vue": "3.5.44"
  }
}
